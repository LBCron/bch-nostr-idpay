{
  "name": "bch-nostr-idpay",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "CashLink DID — Self-Sovereign Bitcoin Cash × Nostr Decentralized Identity, CashScript Anchor Covenant & Instant ParyonUSD (PUSD) Identity Payments via WizardConnect",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LBCron/bch-nostr-idpay.git"
  },
  "scripts": {
    "compile:contracts": "cashc contracts/IdentityAnchor.cash --output src/contracts/IdentityAnchor.artifact.json --format json",
    "dev": "vite",
    "build": "npm run compile:contracts && tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test": "npm run compile:contracts && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@cashscript/utils": "^0.14.0",
    "@electrum-cash/network": "^4.2.2",
    "@electrum-cash/protocol": "^2.3.1",
    "@wizardconnect/core": "^0.2.5",
    "@wizardconnect/dapp": "^0.2.2",
    "@wizardconnect/react": "^0.2.3",
    "@wizardconnect/wallet": "^0.2.3",
    "cashscript": "^0.14.0",
    "nostr-tools": "^2.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cashc": "^0.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
